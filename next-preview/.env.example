# Mẫu biến môi trường cho DMS Portal Next.js (local + production).
# COPY thành `.env.local` (local) hoặc `.env.production` (Ubuntu prod). KHÔNG commit file chứa secret.
#
# ⚠️ NextAuth v4 → dùng NEXTAUTH_URL / NEXTAUTH_SECRET (KHÔNG phải AUTH_URL/AUTH_SECRET của v5).

# --- NextAuth ---
# LOCAL: http://localhost:3000  |  PRODUCTION: https://vanban.biahalong.com
NEXTAUTH_URL=http://localhost:3000
# Sinh secret mạnh: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Entra App (Vanbandieuhanh-API) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- SSO domain restriction: CHỈ tài khoản công ty mới đăng nhập được ---
ALLOWED_EMAIL_DOMAIN=biahalong.com

# --- SharePoint / DMS Library (tên chuẩn hóa SHAREPOINT_*) ---
SHAREPOINT_HOSTNAME=biahalong.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/vanbandieuhanh
# (Tùy chọn) nếu biết site id thì set trực tiếp, sẽ bỏ qua hostname/path:
# SHAREPOINT_SITE_ID=
# Tên document library. Nếu sai/không khớp, app tự thử fallback:
#   DMS · DMS Library · Documents · Shared Documents · Documents partagés
# và trả JSON liệt kê library/drives thật để bạn đặt đúng giá trị.
SHAREPOINT_LIBRARY_NAME=DMS Library

# graph = SharePoint thật (read-only) | mock = MockDmsService
NEXT_PUBLIC_DMS_DATA_SOURCE=graph

# (Tùy chọn) bật log chi tiết NextAuth khi chẩn đoán: AUTH_DEBUG=1

# =============================================================================
# PRODUCTION (.env.production trên Ubuntu):
#   NEXTAUTH_URL=https://vanban.biahalong.com
#   SHAREPOINT_LIBRARY_NAME=DMS Library   (đặt đúng tên thật sau khi audit /api/documents)
#   NODE_ENV=production
#
# Entra App → Authentication → Redirect URIs (Web) — cần CẢ HAI:
#   http://localhost:3000/api/auth/callback/azure-ad
#   https://vanban.biahalong.com/api/auth/callback/azure-ad
# API permissions (delegated, admin consent): User.Read · Sites.Read.All · Files.Read.All
#
# (Tương thích ngược: tên cũ SP_SITE_HOSTNAME / SP_SITE_PATH / SP_DMS_LIBRARY_NAME vẫn đọc được.)
# =============================================================================
