# Mẫu biến môi trường cho DMS Portal Next.js (local + production).
# COPY thành `.env.local` (local) hoặc `.env.production` (Ubuntu prod). KHÔNG commit file chứa secret.
#
# ⚠️ NextAuth v4 → dùng NEXTAUTH_URL / NEXTAUTH_SECRET (KHÔNG phải AUTH_URL/AUTH_SECRET của v5).

# --- NextAuth ---
# LOCAL: http://localhost:3000  |  PRODUCTION: https://vanban.biahalong.com
NEXTAUTH_URL=http://localhost:3000
# Sinh secret mạnh: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Entra App (Vanbandieuhanh-API) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- SSO domain restriction: CHỈ tài khoản công ty mới đăng nhập được ---
ALLOWED_EMAIL_DOMAIN=biahalong.com

# --- SharePoint / DMS Library (tên chuẩn hóa SHAREPOINT_*) ---
SHAREPOINT_HOSTNAME=biahalong.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/vanbandieuhanh
# (Tùy chọn) nếu biết site id thì set trực tiếp, sẽ bỏ qua hostname/path:
# SHAREPOINT_SITE_ID=
# Tên document library. Nếu sai/không khớp, app tự thử fallback:
#   DMS · DMS Library · Documents · Shared Documents · Documents partagés
# và trả JSON liệt kê library/drives thật để bạn đặt đúng giá trị.
SHAREPOINT_LIBRARY_NAME=DMS Library

# graph = SharePoint thật (read-only) | mock = MockDmsService
NEXT_PUBLIC_DMS_DATA_SOURCE=graph

# (Tùy chọn) bật log chi tiết NextAuth khi chẩn đoán: AUTH_DEBUG=1

# =============================================================================
# PRODUCTION (.env.production trên Ubuntu):
#   NEXTAUTH_URL=https://vanban.biahalong.com
#   SHAREPOINT_LIBRARY_NAME=DMS Library   (đặt đúng tên thật sau khi audit /api/documents)
#   NODE_ENV=production
#
# Entra App → Authentication → Redirect URIs (Web) — cần CẢ HAI:
#   http://localhost:3000/api/auth/callback/azure-ad
#   https://vanban.biahalong.com/api/auth/callback/azure-ad
# API permissions (delegated, admin consent): User.Read · Sites.Read.All · Files.Read.All
#
# (Tương thích ngược: tên cũ SP_SITE_HOSTNAME / SP_SITE_PATH / SP_DMS_LIBRARY_NAME vẫn đọc được.)
# =============================================================================

# =============================================================================
# Teams Activity Feed notification (Phase: gửi DMS notification vào tab Activity
# của Teams qua Microsoft Graph sendActivityNotification — bổ sung web + email).
#   - Graph application permission: TeamsActivity.Send (admin consent) + User.Read.All
#   - AZURE_AD_CLIENT_ID PHẢI khớp teams/manifest.json webApplicationInfo.id
#   - manifest activities.activityTypes đã khai báo (dms*).
# =============================================================================
DMS_TEAMS_ACTIVITY_ENABLED=false
# Phase 1: gửi activity tới 1 user test thay vì actor (để trống = gửi cho actor).
DMS_TEAMS_ACTIVITY_TEST_RECIPIENT=
# Send-all: M365 Group id — CHỈ dùng khi TEST_RECIPIENT rỗng. Lấy members (user) làm recipient.
# Để trống = fallback gửi cho actor. Cần app permission GroupMember.Read.All (hoặc Group.Read.All).
DMS_TEAMS_ACTIVITY_GROUP_ID=
# Giới hạn số recipient (0/để trống = không giới hạn). Đặt 2-3 để test an toàn vài user trước.
DMS_TEAMS_ACTIVITY_MAX_RECIPIENTS=
# true = KHÔNG gọi Graph SEND thật (vẫn liệt kê members để đếm). Mặc định: dev=true, prod=false.
DMS_TEAMS_ACTIVITY_DRY_RUN=
# Teams App ID (manifest `id`) — build deep link "Mở trong app". Fallback = manifest id.
TEAMS_APP_ID=b7c24a20-3b43-4fb7-86bc-1a0e4e4e96de
# Diagnostic only (token Graph dùng AZURE_AD_CLIENT_ID/TENANT_ID). Để trống = lấy từ AZURE_AD_*.
TEAMS_BOT_APP_ID=
TEAMS_BOT_TENANT_ID=
# Base URL công khai (đã dùng cho email CTA). Deep link mở /documents/{id}?inTeams=1
DMS_PUBLIC_BASE_URL=https://vanban.biahalong.com

# =============================================================================
# AI Metadata Suggestion (AI-1) — MẶC ĐỊNH RuleBased (không gọi mạng).
#   DMS_AI_PROVIDER=rulebased | azure        (azure CHỈ chạy khi đủ AZURE_OPENAI_* bên dưới)
#   DMS_AI_RATE_LIMIT_PER_MIN=30             (giới hạn req/phút/user cho /api/ai/metadata-suggest)
#   # Khi bật azure (phase sau):
#   AZURE_OPENAI_ENDPOINT=
#   AZURE_OPENAI_API_KEY=
#   AZURE_OPENAI_DEPLOYMENT=
#   AZURE_OPENAI_API_VERSION=
# =============================================================================
DMS_AI_PROVIDER=rulebased
DMS_AI_RATE_LIMIT_PER_MIN=30
