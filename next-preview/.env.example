# Mẫu biến môi trường cho DMS Portal Next.js preview.
# COPY file này thành `.env.local` (KHÔNG commit .env.local) rồi điền giá trị thật.

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
# Sinh chuỗi ngẫu nhiên: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# --- Entra App (Vanbandieuhanh-API) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- SharePoint / DMS Library ---
SP_SITE_HOSTNAME=biahalong.sharepoint.com
SP_SITE_PATH=/sites/vanbandieuhanh
SP_DMS_LIBRARY_NAME=DMS Library

# graph = dùng SharePoint thật (read-only) | mock = dùng MockDmsService
NEXT_PUBLIC_DMS_DATA_SOURCE=graph

# Redirect URI cần khai báo trong Entra App:
#   http://localhost:3000/api/auth/callback/azure-ad
# API permissions (delegated, đã grant): User.Read, Sites.Read.All, Files.Read.All
